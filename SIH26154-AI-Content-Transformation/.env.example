# ==============================================================
# SIH26154 Content Transformation — SIH26154 AI CONTENT TRANSFORMATION
# Put real secrets in .env for LOCAL DEVELOPMENT only.
# NEVER commit .env to Git or expose server-side keys in VITE_* variables.
# ==============================================================

# Supabase Project Settings -> API
VITE_SUPABASE_URL="https://YOUR-PROJECT-ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
# Server-side only; do NOT put this in a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Agentic AI provider ("openrouter" or "gemini")
AGENTIC_AI_PROVIDER="openrouter"
AGENTIC_AI_API_KEY="YOUR_AGENTIC_AI_KEY"
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY"
AGENTIC_AI_MODEL="google/gemini-3.8-flash"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Gemini direct compatibility (optional if using OpenRouter)
GEMINI_API_KEY=""
GOOGLE_API_KEY=""

PORT="3000"
APP_URL="http://localhost:3000"
